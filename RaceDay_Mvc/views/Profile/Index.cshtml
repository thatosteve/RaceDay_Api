@model ProfileViewModel
@{ ViewData["Title"] = "Profile"; }
<div class="container">
    <div class="page-head"><h1>Your profile</h1><p>@Model.Email, signed in as @Model.Role</p></div>
    <div class="row g-4">
        <div class="col-lg-4">
            <div class="panel text-center">
                @if (!string.IsNullOrEmpty(Model.ProfileImageUrl))
                {
                    <img class="avatar mx-auto mb-3" src="@Model.ProfileImageUrl" alt="Profile picture" />
                }
                else
                {
                    <div class="avatar mx-auto mb-3">@Format.Initials(Model.FirstName + " " + Model.LastName)</div>
                }
                <h3 class="mb-3">@Model.FirstName @Model.LastName</h3>
                @if (Model.Role == "Participant")
                {
                    <form asp-action="Picture" method="post" enctype="multipart/form-data" class="text-start">
                        <label class="form-label" for="picture">Profile picture</label>
                        <input class="form-control mb-2" type="file" id="picture" name="picture" accept="image/jpeg,image/png,image/webp" required />
                        <div class="form-text mb-3">JPG, PNG or WEBP, up to 5 MB.</div>
                        <button type="submit" class="btn btn-line w-100">Upload picture</button>
                    </form>
                }
            </div>
        </div>
        <div class="col-lg-8">
            <div class="panel">
                <h2 class="mb-3">Personal details</h2>
                <form asp-action="Index" method="post" novalidate>
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
                    <div class="row g-3 mb-3">
                        <div class="col-sm-6"><label asp-for="FirstName" class="form-label"></label><input asp-for="FirstName" class="form-control" /><span asp-validation-for="FirstName"></span></div>
                        <div class="col-sm-6"><label asp-for="LastName" class="form-label"></label><input asp-for="LastName" class="form-control" /><span asp-validation-for="LastName"></span></div>
                    </div>
                    <div class="row g-3 mb-4">
                        <div class="col-sm-6"><label asp-for="PhoneNumber" class="form-label"></label><input asp-for="PhoneNumber" class="form-control" /><span asp-validation-for="PhoneNumber"></span></div>
                        <div class="col-sm-6"><label asp-for="DateOfBirth" class="form-label"></label><input asp-for="DateOfBirth" type="date" class="form-control" /><span asp-validation-for="DateOfBirth"></span></div>
                    </div>
                    <button type="submit" class="btn btn-rd">Save changes</button>
                </form>
            </div>
        </div>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
