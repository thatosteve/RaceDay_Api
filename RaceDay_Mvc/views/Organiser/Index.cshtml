@model List<OrganiserEventDto>
@{
    ViewData["Title"] = "Dashboard";
    var upcoming = Model.Where(e => e.EventDate >= DateTime.Today).OrderBy(e => e.EventDate).ToList();
    var next = upcoming.FirstOrDefault();
    var first = (Context.Session.GetString(UserSession.NameKey) ?? "").Split(' ').FirstOrDefault();
}
<div class="container">
    <div class="page-head d-flex justify-content-between align-items-end flex-wrap gap-2">
        <div><h1>Welcome back, @first</h1><p>Here's where your events stand.</p></div>
        <a class="btn btn-rd" asp-action="CreateEvent">Create event</a>
    </div>

    <div class="scoreboard mb-4">
        <div><div class="score-num">@Model.Count</div><div class="score-label">events created</div></div>
        <div><div class="score-num">@upcoming.Count</div><div class="score-label">still to come</div></div>
        <div><div class="score-num">@Model.Sum(e => e.EnrolmentCount)</div><div class="score-label">total enrolments</div></div>
        <div>
            @if (next != null) { <div class="score-num">@next.EventDate.ToString("dd MMM")</div><div class="score-label">next up: @next.Name</div> }
            else { <div class="score-num">-</div><div class="score-label">nothing scheduled</div> }
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="empty">
            <h3>You haven't created an event yet.</h3>
            <p class="muted mb-3">Set one up, add categories, and participants can start entering.</p>
            <a class="btn btn-rd" asp-action="CreateEvent">Create your first event</a>
        </div>
    }
    else
    {
        <h2 class="mb-3">Your events</h2>
        <div class="table-wrap">
        <table class="rd-table">
            <thead><tr><th>Event</th><th>Date</th><th>Enrolments</th><th>Results captured</th><th></th></tr></thead>
            <tbody>
            @foreach (var e in Model.OrderBy(x => x.EventDate))
            {
                <tr>
                    <td><strong>@e.Name</strong><div class="muted small">@e.Location, @Format.TypeLabel(e.EventType)</div></td>
                    <td>@Format.Date(e.EventDate)@if (e.EventDate >= DateTime.Today) { <div class="small fw-bold" style="color:var(--hivis-dark)">in @((e.EventDate.Date - DateTime.Today).Days) days</div> }</td>
                    <td><strong>@e.EnrolmentCount</strong></td>
                    <td>@e.ResultCount of @e.EnrolmentCount</td>
                    <td class="text-end">
                        <a class="btn btn-line btn-sm" asp-action="Enrolments" asp-route-id="@e.EventId">Enrolments</a>
                        <a class="btn btn-quiet btn-sm" asp-action="Results" asp-route-id="@e.EventId">Results</a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
        </div>
    }
</div>
