@{
    var role = Context.Session.GetRole();
    var fullName = Context.Session.GetString(UserSession.NameKey);
    var ctrl = ViewContext.RouteData.Values["controller"]?.ToString();
    var act = ViewContext.RouteData.Values["action"]?.ToString();
    string On(string c, string a) => (ctrl == c && act == a) ? "active" : "";
    string OnCtrl(string c, params string[] except) => (ctrl == c && !except.Contains(act)) ? "active" : "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RaceDay</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,400..900&family=Public+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<header>
    <nav class="navbar navbar-expand-lg rd-nav">
        <div class="container">
            <a class="rd-brand" asp-controller="@(role == "Organiser" ? "Organiser" : "Home")" asp-action="Index">Race<span>Day</span></a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">Menu</button>
            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav me-auto ms-lg-4">
                @if (role == "Organiser")
                {
                    <li class="nav-item"><a class="nav-link @On("Organiser", "Index")" asp-controller="Organiser" asp-action="Index">Dashboard</a></li>
                    <li class="nav-item"><a class="nav-link @OnCtrl("Organiser", "Index", "CreateEvent")" asp-controller="Organiser" asp-action="Events">My events</a></li>
                    <li class="nav-item"><a class="nav-link @On("Organiser", "CreateEvent")" asp-controller="Organiser" asp-action="CreateEvent">Create event</a></li>
                    <li class="nav-item"><a class="nav-link @On("Profile", "Index")" asp-controller="Profile" asp-action="Index">Profile</a></li>
                }
                else if (role == "Participant")
                {
                    <li class="nav-item"><a class="nav-link @On("Home", "Index")" asp-controller="Home" asp-action="Index">Find events</a></li>
                    <li class="nav-item"><a class="nav-link @On("Home", "MyEvents")" asp-controller="Home" asp-action="MyEvents">My entries</a></li>
                    <li class="nav-item"><a class="nav-link @On("Home", "MyResults")" asp-controller="Home" asp-action="MyResults">My results</a></li>
                    <li class="nav-item"><a class="nav-link @On("Profile", "Index")" asp-controller="Profile" asp-action="Index">Profile</a></li>
                }
                </ul>
                <div class="d-flex align-items-center gap-2">
                @if (role != null)
                {
                    <span class="rd-user">Signed in as <strong>@fullName</strong> (@role)</span>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                        <button type="submit" class="btn btn-sm btn-light fw-bold">Log out</button>
                    </form>
                }
                else
                {
                    <a class="btn btn-sm btn-light fw-bold" asp-controller="Account" asp-action="Login">Log in</a>
                    <a class="btn btn-sm btn-rd" asp-controller="Account" asp-action="Register">Sign up</a>
                }
                </div>
            </div>
        </div>
    </nav>
</header>

<main>
    @if (TempData["Success"] is string ok)
    {
        <div class="container pt-3"><div class="alert alert-success alert-dismissible fade show mb-0" role="alert">@ok<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button></div></div>
    }
    @if (TempData["Error"] is string err)
    {
        <div class="container pt-3"><div class="alert alert-danger alert-dismissible fade show mb-0" role="alert">@err<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button></div></div>
    }
    @if (ViewBag.LoadError is string loadErr)
    {
        <div class="container pt-3"><div class="alert alert-warning mb-0" role="alert">@loadErr</div></div>
    }
    @RenderBody()
</main>

<footer class="rd-footer">
    <div class="container">RaceDay. Built for the runners, walkers and cyclists who turn up every weekend across South Africa.</div>
</footer>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
