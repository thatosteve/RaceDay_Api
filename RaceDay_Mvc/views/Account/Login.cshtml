@model LoginViewModel
@{ ViewData["Title"] = "Log in"; }
<div class="auth-wrap">
    <div class="auth-hero"><div>
        <h1>Your next finish line starts here.</h1>
        <p>Enter road runs, walks and cycle events across South Africa, and keep every result you earn.</p>
    </div></div>
    <div class="auth-card">
        <h2 class="mb-4">Welcome back</h2>
        <form asp-action="Login" method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
            <input type="hidden" asp-for="ReturnUrl" />
            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" autocomplete="email" />
                <span asp-validation-for="Email"></span>
            </div>
            <div class="mb-4">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" class="form-control" autocomplete="current-password" />
                <span asp-validation-for="Password"></span>
            </div>
            <button type="submit" class="btn btn-rd w-100">Log in</button>
        </form>
        <p class="mt-4 mb-0">New to RaceDay? <a asp-action="Register">Create an account</a></p>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
