@model RegisterViewModel
@{ ViewData["Title"] = "Create account"; }
<div class="auth-wrap">
    <div class="auth-hero"><div>
        <h1>Pin on your bib.</h1>
        <p>Organisers publish events and capture results. Participants enter, race and track their history.</p>
    </div></div>
    <div class="auth-card">
        <h2 class="mb-4">Create your account</h2>
        <form asp-action="Register" method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
            <div class="mb-3">
                <div class="form-label">I am joining as</div>
                <div class="role-pick">
                    <label><input type="radio" asp-for="Role" value="Participant" />Participant<small>Enter events and track results</small></label>
                    <label><input type="radio" asp-for="Role" value="Organiser" />Organiser<small>Create events and capture results</small></label>
                </div>
                <span asp-validation-for="Role"></span>
            </div>
            <div class="row g-3 mb-3">
                <div class="col-sm-6"><label asp-for="FirstName" class="form-label"></label><input asp-for="FirstName" class="form-control" /><span asp-validation-for="FirstName"></span></div>
                <div class="col-sm-6"><label asp-for="LastName" class="form-label"></label><input asp-for="LastName" class="form-control" /><span asp-validation-for="LastName"></span></div>
            </div>
            <div class="mb-3"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control" autocomplete="email" /><span asp-validation-for="Email"></span></div>
            <div class="row g-3 mb-3">
                <div class="col-sm-6"><label asp-for="Password" class="form-label"></label><input asp-for="Password" class="form-control" autocomplete="new-password" /><span asp-validation-for="Password"></span></div>
                <div class="col-sm-6"><label asp-for="ConfirmPassword" class="form-label"></label><input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" /><span asp-validation-for="ConfirmPassword"></span></div>
            </div>
            <div class="row g-3 mb-4">
                <div class="col-sm-6"><label asp-for="PhoneNumber" class="form-label"></label><input asp-for="PhoneNumber" class="form-control" /><span asp-validation-for="PhoneNumber"></span></div>
                <div class="col-sm-6"><label asp-for="DateOfBirth" class="form-label"></label><input asp-for="DateOfBirth" type="date" class="form-control" /><span asp-validation-for="DateOfBirth"></span></div>
            </div>
            <button type="submit" class="btn btn-rd w-100">Create account</button>
        </form>
        <p class="mt-4 mb-0">Already registered? <a asp-action="Login">Log in</a></p>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
