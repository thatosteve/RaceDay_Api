@model OrganiserEventViewModel
@{ ViewData["Title"] = "Enrolments"; }
<div class="container">
    <div class="page-head">
        <a asp-action="Events" class="small">Back to my events</a>
        <h1 class="mt-2">Enrolments for @Model.Event.Name</h1>
        <p>@Format.DateAt(Model.Event.EventDate), @Model.Event.Location. @Model.Enrolments.Count(e => e.Status == "Confirmed") confirmed, @Model.Enrolments.Count(e => e.Status == "Pending") pending.</p>
    </div>
    @if (!Model.Enrolments.Any())
    {
        <div class="empty"><h3>Nobody has entered yet.</h3><p class="muted mb-0">Enrolments will appear here as participants sign up.</p></div>
    }
    else
    {
        <div class="table-wrap">
        <table class="rd-table">
            <thead><tr><th>Participant</th><th>Category</th><th>Entered</th><th>Status</th><th></th></tr></thead>
            <tbody>
            @foreach (var en in Model.Enrolments)
            {
                <tr>
                    <td><strong>@en.ParticipantName</strong><div class="muted small">@en.ParticipantEmail</div></td>
                    <td>@en.CategoryName</td>
                    <td>@Format.Date(en.EnrolledAt.ToLocalTime())</td>
                    <td><partial name="_StatusBadge" model="en.Status" /></td>
                    <td class="text-end">
                        <form asp-action="SetStatus" asp-route-id="@Model.Event.EventId" method="post" class="d-inline">
                            <input type="hidden" name="enrolmentId" value="@en.EnrolmentId" />
                            @if (en.Status == "Pending") { <input type="hidden" name="status" value="Confirmed" /><button type="submit" class="btn btn-line btn-sm">Confirm</button> }
                            else { <input type="hidden" name="status" value="Pending" /><button type="submit" class="btn btn-quiet btn-sm">Set to pending</button> }
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
        </div>
    }
</div>
