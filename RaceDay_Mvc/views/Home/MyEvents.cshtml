@model List<MyEnrolmentDto>
@{ ViewData["Title"] = "My entries"; }
<div class="container">
    <div class="page-head">
        <h1>My entries</h1>
        <p>Pending means the organiser hasn't confirmed your entry yet. Confirmed means you're on the start list.</p>
    </div>
    @if (!Model.Any())
    {
        <div class="empty">
            <h3>You haven't entered anything yet.</h3>
            <p class="muted mb-3">Find an event and pick your category.</p>
            <a class="btn btn-rd" asp-action="Index">Find events</a>
        </div>
    }
    else
    {
        @foreach (var m in Model)
        {
            <div class="row-card">
                <div class="bib-date">
                    <div class="bib-day">@m.EventDate.ToString("dd")</div>
                    <div class="bib-month">@m.EventDate.ToString("MMM")</div>
                </div>
                <div class="grow">
                    <h3 class="mb-1"><a asp-action="Details" asp-route-id="@m.EventId" class="text-decoration-none">@m.EventName</a></h3>
                    <div class="muted">Category: <strong>@m.CategoryName</strong>. Entered @Format.Date(m.EnrolledAt.ToLocalTime())</div>
                </div>
                <partial name="_StatusBadge" model="m.Status" />
            </div>
        }
    }
</div>
