@model EventDetailsViewModel
@{
    var e = Model.Event;
    ViewData["Title"] = e.Name;
    var finished = e.EventDate < DateTime.Now;
    var bg = string.IsNullOrEmpty(e.BannerImageUrl) ? "" : $"background-image:url('{e.BannerImageUrl}')";
}
<div class="container py-4">
    <a asp-controller="Home" asp-action="Index" class="small">Back to events</a>
    <div class="bib mt-3" style="height:auto">
        <div class="bib-banner type-@e.EventType @(string.IsNullOrEmpty(e.BannerImageUrl) ? "nopic" : "")" style="height:260px;@bg">
            <span class="bib-type">@Format.TypeLabel(e.EventType)</span>
        </div>
    </div>

    <div class="row g-4 mt-1">
        <div class="col-lg-7">
            <h1 class="mb-2">@e.Name</h1>
            <dl class="facts">
                <div><dt>When</dt><dd>@Format.DateAt(e.EventDate)</dd></div>
                <div><dt>Where</dt><dd>@e.Location</dd></div>
                <div><dt>Distance</dt><dd>@Format.Km(e.DistanceKm)</dd></div>
            </dl>
            <h3>About this event</h3>
            <p style="max-width:65ch">@(string.IsNullOrWhiteSpace(e.Description) ? "The organiser hasn't added a description yet." : e.Description)</p>
        </div>

        <div class="col-lg-5">
            <div class="panel">
                <h2 class="mb-3">@(Model.Enrolment != null ? "Your entry" : "Enter this event")</h2>
                @if (!Model.IsParticipant)
                {
                    <p class="muted">You're viewing as an organiser. Only participants can enter events.</p>
                    @foreach (var c in e.Categories ?? new())
                    {
                        <div class="cat-option">@c.Name<span class="cat-type">@c.CategoryType</span></div>
                    }
                }
                else if (Model.Enrolment != null)
                {
                    <p class="mb-2">You're entered in <strong>@Model.Enrolment.CategoryName</strong>.</p>
                    <partial name="_StatusBadge" model="Model.Enrolment.Status" />
                    <p class="muted small mt-3 mb-0">Entered on @Format.Date(Model.Enrolment.EnrolledAt.ToLocalTime()). Pending means the organiser hasn't confirmed you yet.</p>
                }
                else if (finished)
                {
                    <p class="muted mb-0">This event has already taken place, so entries are closed.</p>
                }
                else if (e.Categories == null || e.Categories.Count == 0)
                {
                    <p class="muted mb-0">The organiser hasn't opened any categories yet. Check back soon.</p>
                }
                else
                {
                    <form asp-action="Enrol" asp-route-id="@e.EventId" method="post">
                        <p class="muted">Choose the category you'll race in.</p>
                        @foreach (var c in e.Categories)
                        {
                            <label class="cat-option"><input type="radio" name="categoryId" value="@c.CategoryId" required />@c.Name<span class="cat-type">@c.CategoryType</span></label>
                        }
                        <button type="submit" class="btn btn-rd w-100 mt-2">Enter event</button>
                    </form>
                }
            </div>
        </div>
    </div>
</div>
