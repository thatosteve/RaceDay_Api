@model EventFormViewModel
@{
    var isEdit = (bool)(ViewBag.IsEdit ?? false);
    ViewData["Title"] = isEdit ? "Edit event" : "Create event";
}
<div class="container">
    <div class="page-head"><h1>@(isEdit ? "Edit event" : "Create an event")</h1><p>Participants see all of this on the event page.</p></div>
    <div class="panel" style="max-width:52rem">
        <form asp-action="@(isEdit ? "EditEvent" : "CreateEvent")" asp-route-id="@(isEdit ? Model.EventId.ToString() : null)" method="post" enctype="multipart/form-data" novalidate>
            <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
            <div class="mb-3"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" /><span asp-validation-for="Name"></span></div>
            <div class="mb-3"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" class="form-control" rows="4"></textarea><span asp-validation-for="Description"></span></div>
            <div class="row g-3 mb-3">
                <div class="col-md-6"><label asp-for="EventDate" class="form-label"></label><input asp-for="EventDate" type="datetime-local" class="form-control" /><span asp-validation-for="EventDate"></span></div>
                <div class="col-md-6"><label asp-for="Location" class="form-label"></label><input asp-for="Location" class="form-control" /><span asp-validation-for="Location"></span></div>
            </div>
            <div class="row g-3 mb-3">
                <div class="col-md-6"><label asp-for="DistanceKm" class="form-label"></label><input asp-for="DistanceKm" type="number" step="0.1" min="0.1" class="form-control" /><span asp-validation-for="DistanceKm"></span></div>
                <div class="col-md-6">
                    <label asp-for="EventType" class="form-label"></label>
                    <select asp-for="EventType" class="form-select">
                        <option value="run">Run</option><option value="walk">Walk</option><option value="cycle">Cycle</option>
                    </select>
                    <span asp-validation-for="EventType"></span>
                </div>
            </div>
            <div class="mb-4">
                <label asp-for="Banner" class="form-label"></label>
                @if (!string.IsNullOrEmpty(Model.ExistingBannerUrl))
                {
                    <div class="mb-2"><img src="@Model.ExistingBannerUrl" alt="Current banner" style="max-height:140px;border-radius:6px" /><div class="form-text">Current banner. Choose a new file to replace it.</div></div>
                }
                <input asp-for="Banner" type="file" class="form-control" accept="image/jpeg,image/png,image/webp" />
                <div class="form-text">JPG, PNG or WEBP, up to 5 MB.</div>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-rd">@(isEdit ? "Save changes" : "Create event")</button>
                <a class="btn btn-quiet" asp-action="Events">Cancel</a>
            </div>
        </form>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
