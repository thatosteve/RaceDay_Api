@model OrganiserEventViewModel
@{
    ViewData["Title"] = "Results";
    var concluded = Model.Event.EventDate <= DateTime.Now;
}
<div class="container">
    <div class="page-head">
        <a asp-action="Events" class="small">Back to my events</a>
        <h1 class="mt-2">Results for @Model.Event.Name</h1>
        <p>@Format.DateAt(Model.Event.EventDate), @Model.Event.Location. Saved results show on each participant's My results page straight away.</p>
    </div>

    @if (!concluded)
    {
        <div class="alert alert-warning">This event hasn't taken place yet, so results can't be captured. Come back after @Format.Date(Model.Event.EventDate).</div>
    }

    @if (!Model.Enrolments.Any())
    {
        <div class="empty"><h3>No participants to record.</h3><p class="muted mb-0">Results can only be captured for people who entered.</p></div>
    }
    else
    {
        <p class="muted">Enter finish time as hh:mm:ss (for example 01:45:30) and the overall finishing position.</p>
        @foreach (var en in Model.Enrolments)
        {
            <form asp-action="SaveResult" asp-route-id="@Model.Event.EventId" method="post" class="result-row">
                <input type="hidden" name="enrolmentId" value="@en.EnrolmentId" />
                <input type="hidden" name="resultId" value="@en.ResultId" />
                <div><strong>@en.ParticipantName</strong><div class="muted small">@en.CategoryName <partial name="_StatusBadge" model="en.Status" /></div></div>
                <div><label class="form-label small" for="t@(en.EnrolmentId)">Finish time</label>
                    <input class="form-control" id="t@(en.EnrolmentId)" name="finishTime" placeholder="hh:mm:ss" pattern="\d{1,2}:[0-5]\d:[0-5]\d" value="@(en.FinishTime.HasValue ? Format.Time(en.FinishTime) : "")" required disabled="@(!concluded)" /></div>
                <div><label class="form-label small" for="p@(en.EnrolmentId)">Position</label>
                    <input class="form-control" id="p@(en.EnrolmentId)" name="finishPosition" type="number" min="1" value="@en.FinishPosition" required disabled="@(!concluded)" /></div>
                <div>@if (en.ResultId.HasValue) { <span class="status status-confirmed">Published</span> } else { <span class="muted small">Not captured</span> }</div>
                <div><button type="submit" class="btn btn-rd" disabled="@(!concluded)">@(en.ResultId.HasValue ? "Update" : "Save")</button></div>
            </form>
        }
    }
</div>
